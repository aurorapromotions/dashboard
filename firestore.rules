rules_version = '2';
// Aurora Promotions Dashboard security rules. Published in the Firebase console (Firestore → Rules);
// keep this file and the console in sync.
//
// People live in members/{lowercase email}: {name, role: "admin"|"member", active, loginType, uid?, access: {tool: "limited"|"full"}}.
// - The main admin (ihsan@aurorapromotions.ca, Google sign-in) is always an admin.
// - Admins: full access to every tool and manage members.
// - Members: per tool, "full" (team lead) or "limited" (own records, add/edit, no delete).
// - Google logins must be verified Google accounts; email/password logins must be the exact account an admin created (uid).
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(email()); }
    function viaGoogle() {
      return request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return request.auth != null && request.auth.token.email != null && viaGoogle()
        && email() == 'ihsan@aurorapromotions.ca';
    }
    function m() { return get(memberPath()).data; }
    function isMember() {
      return request.auth != null && request.auth.token.email != null && exists(memberPath())
        && m().active == true && (viaGoogle() || m().get('uid', '') == request.auth.uid);
    }
    function isAdmin() { return isOwner() || (isMember() && m().role == 'admin'); }
    function level(tool) {
      return isAdmin() ? 'full' : (isMember() ? m().get('access', {}).get(tool, 'none') : 'none');
    }
    function full(tool) { return level(tool) == 'full'; }
    function limited(tool) { return level(tool) == 'limited'; }
    function myName() { return m().name; }

    match /members/{who} {
      // everyone on the team can see who's who (needed to assign tasks); only admins change it
      allow read: if isAdmin() || isMember();
      // only admins manage people; only the main admin can change the main admin's record
      allow create, update: if isAdmin() && (who != 'ihsan@aurorapromotions.ca' || isOwner())
        && request.resource.data.role in ['admin', 'member'];
      allow delete: if false;
    }

    // ---------- Sales Navigator ----------
    match /orders/{id} {
      allow read: if full('sales') || (limited('sales') && resource.data.salesRep == myName());
      allow create: if full('sales') || (limited('sales') && request.resource.data.salesRep == myName());
      allow update: if full('sales')
        || (limited('sales') && resource.data.salesRep == myName() && request.resource.data.salesRep == myName());
      allow delete: if full('sales');
    }
    match /settings/config {
      allow read: if level('sales') != 'none';
      allow write: if full('sales');
    }
    match /counters/orders {
      allow read, create: if level('sales') != 'none';
      allow update: if level('sales') != 'none' && request.resource.data.next > resource.data.next;
    }

    // ---------- Projects ----------
    // projects/{id} and tasks/{id} both carry `team` (member emails); limited people see only what they're on.
    // Limited: add tasks for themselves, edit their own tasks (not reassign), comment on any task of their projects.
    match /projects/{id} {
      allow read: if full('projects') || (limited('projects') && email() in resource.data.team);
      allow create, update, delete: if full('projects');
    }
    match /tasks/{id} {
      allow read: if full('projects') || (limited('projects') && email() in resource.data.team);
      allow create: if full('projects') || (limited('projects')
        && request.resource.data.assignee == email()
        && email() in request.resource.data.team
        && request.resource.data.team == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.team);
      allow update: if full('projects') || (limited('projects') && email() in resource.data.team
        && request.resource.data.team == resource.data.team
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.assignee == resource.data.assignee
        && (resource.data.assignee == email()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'updatedAt'])));
      allow delete: if full('projects');
    }
    match /settings/projects {
      allow read: if level('projects') != 'none';
      allow write: if full('projects');
    }

    // ---------- Clients & Seasons ----------
    // clients/{email or name-company key} and outreach/{seasonId__clientId} carry `owner` = the sales rep's name.
    // Limited: only their own clients and outreach, add and edit, no delete. Seasons and settings: full only.
    match /clients/{id} {
      allow read: if full('clients') || (limited('clients') && resource.data.owner == myName());
      allow create: if full('clients') || (limited('clients') && request.resource.data.owner == myName());
      allow update: if full('clients')
        || (limited('clients') && resource.data.owner == myName() && request.resource.data.owner == myName());
      allow delete: if full('clients');
    }
    match /outreach/{id} {
      allow read: if full('clients') || (limited('clients') && resource.data.owner == myName());
      allow create: if full('clients') || (limited('clients') && request.resource.data.owner == myName());
      allow update: if full('clients')
        || (limited('clients') && resource.data.owner == myName() && request.resource.data.owner == myName());
      allow delete: if full('clients');
    }
    match /seasons/{id} {
      allow read: if level('clients') != 'none';
      allow write: if full('clients');
    }
    match /settings/clients {
      allow read: if level('clients') != 'none';
      allow write: if full('clients');
    }

    // ---------- Order Acceptance ----------
    // terms/v{n}: published Terms & Conditions versions. Never changed or deleted once published,
    // so it is always clear which version a client accepted.
    match /terms/{id} {
      allow read: if level('acceptance') != 'none';
      allow create: if full('acceptance');
      allow update, delete: if false;
    }
    // acceptances/{token}: order + terms snapshot for the client page accept/?id=<token>.
    // The token is long and random, so "get" is open to whoever has the link (no listing).
    // Staff: full = all, limited = their own invoices (salesRep == their name).
    // Once accepted, staff can only change status/payment fields, never the acceptance record itself.
    // The client (not signed in) can do exactly one thing: accept a sent order with their name and the server time.
    function staffAcc() {
      return full('acceptance') || (limited('acceptance') && resource.data.salesRep == myName()
        && request.resource.data.salesRep == myName());
    }
    match /acceptances/{id} {
      allow get: if true;
      allow list: if full('acceptance') || (limited('acceptance') && resource.data.salesRep == myName());
      allow create: if (full('acceptance') || (limited('acceptance') && request.resource.data.salesRep == myName()))
        && request.resource.data.status == 'draft' && id.size() >= 20;
      allow update: if (staffAcc()
          && (!(resource.data.status in ['accepted', 'paid'])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy', 'payment', 'history', 'updatedAt', 'updatedBy']))
          && (resource.data.status in ['accepted', 'paid'] || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['acceptedName', 'acceptedAt', 'acceptedUserAgent']))
          // only the client can turn an order into "accepted"
          && (request.resource.data.status != 'accepted' || resource.data.status == 'accepted'))
        || (resource.data.status == 'sent' && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedName', 'acceptedAt', 'acceptedUserAgent'])
          && request.resource.data.acceptedName is string
          && request.resource.data.acceptedName.size() >= 2 && request.resource.data.acceptedName.size() <= 100
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.acceptedUserAgent is string && request.resource.data.acceptedUserAgent.size() <= 300);
      allow delete: if full('acceptance') && !(resource.data.status in ['accepted', 'paid']);
    }
  }
}
