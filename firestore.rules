rules_version = '2';
// Only signed-in Google accounts with an @aurorapromotions.ca email can read or write data.
// This is what is published in the Firebase console (Firestore → Rules); keep the two in sync.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@aurorapromotions[.]ca$');
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
